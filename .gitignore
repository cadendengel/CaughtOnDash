# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependency and build output
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
bin/
obj/
desktop_worker/src/worker/bin/
desktop_worker/src/worker/obj/
backend/staticfiles/
backend/db.sqlite3
*.sqlite3
*.sqlite
# WAL journal sidecars, created by the local sqlite settings
*.sqlite3-wal
*.sqlite3-shm

# Local config and environment files
.env
.env.*
*.local
backend/.env
frontend/.env
desktop_worker/src/worker/appsettings.json
desktop_worker/src/worker/appsettings.*.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.user
*.rsuser
*.cache

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
# Desktop worker local config (holds the backend API token)
desktop_worker/src/*/appsettings.json
desktop_worker/src/*/appsettings.*.json

# Model weights, downloaded on first run into the analyzer working directory
desktop_worker/analyzer/*.pt

# Playwright MCP session artifacts
.playwright-mcp/
