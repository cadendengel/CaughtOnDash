<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:CaughtOnDash.Worker.Services"
        x:Class="CaughtOnDash.Worker.Mac.MainWindow"
        Title="CaughtOnDash Worker" Height="800" Width="1440"
        MinHeight="600" MinWidth="1100"
        Background="#F5F5F5"
        FontSize="12">

    <Window.Styles>
        <!-- Buttons shipped with the text against the edges; give them room. -->
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
            <StackPanel Margin="15">
                <TextBlock Text="CaughtOnDash Desktop Worker" FontSize="18" FontWeight="Bold" Foreground="#1A1A1A"/>
                <TextBlock Text="Process dashcam videos locally" Foreground="#666666" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <!-- Log on the right because it is the tall content; status and progress
             stack on the left. The reverse left the short Processing card in a
             full-height column and squeezed the log into half of the other. -->
        <Grid Grid.Row="1" Margin="15" ColumnDefinitions="300,*,360">

            <!-- Left: status, progress, controls -->
            <Grid Grid.Column="0" Margin="0,0,15,0" RowDefinitions="Auto,Auto,*">
                <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="5" Margin="0,0,0,15">
                    <StackPanel Margin="15">
                        <TextBlock Text="Worker Status" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Status:" FontWeight="SemiBold"/>
                            <!-- The dot replaces two heartbeat log lines every ten
                                 seconds. A heartbeat is a state, so it is shown as
                                 one; only a failure now reaches the log. -->
                            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,3,0,0">
                                <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#B0B0B0"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#E74C3C" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Last Heartbeat:" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LastHeartbeatText" Text="Never" FontSize="13" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Current Job:" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CurrentJobText" Text="None" FontSize="13" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="10">
                            <!-- Connect/Disconnect, not Start/Stop: this controls
                                 whether the worker is online, not whether work
                                 happens. Work is controlled by what is queued,
                                 which is why an "Idle" status exists at all.
                                 "Start" now means one thing everywhere: put this
                                 work in motion. -->
                            <Button x:Name="StartButton" Content="Connect" Click="StartButton_Click"
                                    Background="#27AE60" Foreground="White" Height="35" Width="110"
                                    ToolTip.Tip="Go online and run whatever is queued"/>
                            <Button x:Name="StopButton" Content="Disconnect" Click="StopButton_Click"
                                    Background="#E74C3C" Foreground="White" Height="35" Width="110" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Whole card hides when idle. A progress bar sitting at 0%
                     reads as stuck; nothing there reads as nothing running. -->
                <Border Grid.Row="1" x:Name="ProcessingPanel" IsVisible="False"
                        Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                    <StackPanel Margin="15">
                        <TextBlock Text="Processing" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Progress:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ProgressBar x:Name="JobProgressBar" Height="20" Foreground="#0066CC"
                                         Value="0" Minimum="0" Maximum="100"/>
                            <TextBlock x:Name="ProgressText" Text="0%" Margin="0,5,0,0"
                                       HorizontalAlignment="Center" Foreground="#666666"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Stage:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="StageText" Text="Idle" FontSize="13" Foreground="#666666"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Job Details:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="JobDetailsText" Text="No active job" FontSize="13"
                                       Foreground="#666666" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button x:Name="CancelJobButton" Content="Cancel Current Job" Click="CancelJobButton_Click"
                                Background="#E67E22" Foreground="White" Height="35"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                IsEnabled="False"/>
                    </StackPanel>
                </Border>

                <!-- Shown in the Processing card's place while nothing is running. -->
                <Border Grid.Row="1" x:Name="IdlePanel" Background="White" BorderBrush="#E0E0E0"
                        BorderThickness="1" CornerRadius="5">
                    <StackPanel Margin="15">
                        <TextBlock Text="Processing" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <TextBlock x:Name="IdleText" Text="No job running." FontSize="13" Foreground="#888888"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Middle: the review queue. This is the working surface — choose
                 what runs, in what order, with enough context to decide. -->
            <Border Grid.Column="1" Margin="0,0,15,0" Background="White" BorderBrush="#E0E0E0"
                    BorderThickness="1" CornerRadius="5">
                <Grid Margin="15" RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="QueueHeading" Text="Not started" FontWeight="Bold" FontSize="14"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RequeueOutdatedButton" Content="Requeue outdated"
                                    Click="RequeueOutdatedButton_Click" Padding="10,3"
                                    ToolTip.Tip="Re-run every video not on the current analyzer version"/>
                            <Button x:Name="RefreshQueueButton" Content="Refresh"
                                    Click="RefreshQueueButton_Click" Padding="10,3"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,10">
                        <Button x:Name="ReviewTabButton" Content="Not started" Click="ReviewTab_Click"/>
                        <Button x:Name="QueuedTabButton" Content="Queued" Click="QueuedTab_Click"/>
                        <TextBlock x:Name="QueueCountText" Text="" VerticalAlignment="Center"
                                   Foreground="#666666" Margin="8,0,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="QueueGrid" AutoGenerateColumns="False"
                              RowHeight="52"
                              x:DataType="svc:QueueRow"
                              GridLinesVisibility="Horizontal"
                              CanUserReorderColumns="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" Background="White">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="40"/>
                            <DataGridTemplateColumn Header="" Width="86" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:QueueRow">
                                        <Border Background="#EEEEEE" Width="76" Height="44"
                                                Margin="2" CornerRadius="3">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Title" Binding="{Binding Entry.Title}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Length" Binding="{Binding Entry.DurationDisplay}" Width="84" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Attempt" Binding="{Binding Entry.AttemptDisplay}" Width="90" IsReadOnly="True"/>
                            <!-- 3*, and a tooltip carrying the full text. HistoryDisplay runs to ~90
                                 characters ("Attempt 2: " plus an 80-character summary) and the
                                 columns are star-sized, so they always total the grid width: the text
                                 was being clipped mid-sentence with no way to read the rest.
                                 A template column rather than DataGridTextColumn + ElementStyle,
                                 which Avalonia's DataGrid does not have. -->
                            <DataGridTemplateColumn Header="Last result" Width="3*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:QueueRow">
                                        <TextBlock Text="{Binding Entry.HistoryDisplay}"
                                                   ToolTip.Tip="{Binding Entry.HistoryDisplay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="12,0,12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SelectAllButton" Margin="0,0,8,8" Content="Select all" Click="SelectAll_Click"/>
                        <Button x:Name="ClearSelectionButton" Margin="0,0,8,8" Content="Clear" Click="ClearSelection_Click"/>
                        <Button x:Name="PreviewButton" Margin="0,0,8,8" Content="Preview" Click="Preview_Click"
                                ToolTip.Tip="Open the selected video in your browser"/>
                        <Button x:Name="MoveUpButton" Margin="0,0,8,8" Content="Up" Click="MoveUp_Click"/>
                        <Button x:Name="MoveDownButton" Margin="0,0,8,8" Content="Down" Click="MoveDown_Click"/>
                        <Button x:Name="RejectButton" Margin="0,0,8,8" Content="Skip" Click="Reject_Click"
                                Background="#C0392B" Foreground="White"/>
                        <Button x:Name="StartBatchButton" Margin="0,0,8,8" Content="Start selected" Click="StartBatch_Click"
                                Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="14,4"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Right: the activity log, full height -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                <Grid Margin="15" RowDefinitions="Auto,*">
                    <TextBlock Text="Activity Log" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <ListBox Grid.Row="1" x:Name="LogListBox" BorderThickness="0" Background="#F9F9F9" Margin="2"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
            <StackPanel Orientation="Horizontal" Margin="15">
                <TextBlock Text="Version 0.1.0" Foreground="#999999" Margin="0,0,20,0"/>
                <TextBlock Text="Backend:" Foreground="#666666" Margin="0,0,5,0"/>
                <TextBlock x:Name="BackendUrlDisplay" Text="Not configured" Foreground="#0066CC"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
