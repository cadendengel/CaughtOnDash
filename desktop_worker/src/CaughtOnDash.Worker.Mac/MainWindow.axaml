<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:CaughtOnDash.Worker.Services"
        xmlns:local="using:CaughtOnDash.Worker.Mac"
        x:Class="CaughtOnDash.Worker.Mac.MainWindow"
        Title="CaughtOnDash Worker" Height="820" Width="1440"
        MinHeight="600" MinWidth="1100"
        Background="#EEF0F3"
        Foreground="#1F2328"
        FontSize="12">

    <Window.Resources>
        <local:GroupColour x:Key="GroupColour"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Buttons shipped with the text against the edges; give them room. -->
        <Style Selector="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C4CAD3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DCE2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <!-- The band above each group: the group's name and count only. Its
             colour is set as it loads (see QueueGrid_LoadingRowGroup). -->
        <Style Selector="DataGridRowGroupHeader">
            <Setter Property="IsItemCountVisible" Value="False"/>
            <Setter Property="IsPropertyNameVisible" Value="False"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- The theme sizes cells at 15; match the rest of the window. -->
        <Style Selector="DataGridCell">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ListBox#LogListBox ListBoxItem">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#57606A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Header: who this is, whether it is connected, and the one switch.
             Connecting is always by hand: nothing runs until you say so. -->
        <Border Grid.Row="0" Background="White" BorderThickness="0,0,0,1" BorderBrush="#D8DCE2">
            <Grid Margin="24,12" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CaughtOnDash Worker" FontSize="18" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Backend " Foreground="#57606A"/>
                        <TextBlock x:Name="BackendUrlDisplay" Text="Not configured" Foreground="#57606A"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border x:Name="ConnectionPill" CornerRadius="14" Padding="12,5" Margin="0,0,4,0"
                            Background="#EEF0F3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#8C959F"
                                     VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <TextBlock x:Name="StatusText" Text="Disconnected" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="LastHeartbeatText" Text="" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="StartButton" Content="Connect" Click="StartButton_Click"
                            Background="#15803D" BorderBrush="#15803D" Foreground="White" FontWeight="SemiBold"
                            Height="34" ToolTip.Tip="Go online and run whatever is queued"/>
                    <Button x:Name="StopButton" Content="Disconnect" Click="StopButton_Click"
                            BorderBrush="#B91C1C" Foreground="#B91C1C" FontWeight="SemiBold"
                            Height="34" IsVisible="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,16" ColumnDefinitions="*,340">

            <!-- The queue: one list, grouped in the order things happen. -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,16,0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border BorderBrush="#E6E9EE" BorderThickness="0,0,0,1">
                        <Grid Margin="16,12" ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="Queue" FontWeight="Bold" FontSize="15"/>
                                <TextBlock x:Name="QueueCountText" Foreground="#57606A" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ResetStaleButton" Content="Free stuck"
                                        Click="ResetStaleButton_Click"
                                        ToolTip.Tip="Put jobs back in the queue when the worker that claimed them died"/>
                                <Button x:Name="RequeueOutdatedButton" Content="Requeue outdated"
                                        Click="RequeueOutdatedButton_Click"
                                        ToolTip.Tip="Re-run every video not on the current analyzer version"/>
                                <Button x:Name="RefreshQueueButton" Content="Refresh"
                                        Click="RefreshQueueButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="QueueGrid" AutoGenerateColumns="False"
                              RowHeight="52"
                              x:DataType="svc:QueueRow"
                              GridLinesVisibility="None"
                              CanUserReorderColumns="False" CanUserSortColumns="False"
                              CanUserResizeColumns="False"
                              HeadersVisibility="Column" Background="White" FontSize="12"
                              LoadingRow="QueueGrid_LoadingRow"
                              LoadingRowGroup="QueueGrid_LoadingRowGroup">
                        <DataGrid.Columns>
                            <!-- A plain CheckBox rather than DataGridCheckBoxColumn, which
                                 needed one click to select the row and a second to tick it. -->
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:QueueRow">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Tick"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="86" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:QueueRow">
                                        <Border Background="#E6E9EE" Width="76" Height="44"
                                                Margin="2" CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Template columns rather than DataGridTextColumn + ElementStyle,
                                 which Avalonia's DataGrid does not have. -->
                            <DataGridTemplateColumn Header="Title" Width="2*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:QueueRow">
                                        <TextBlock Text="{Binding Entry.Title}" FontWeight="SemiBold"
                                                   ToolTip.Tip="{Binding Entry.Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Length" Width="84" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:QueueRow">
                                        <TextBlock Text="{Binding Entry.DurationDisplay}"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Attempt" Width="92" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:QueueRow">
                                        <TextBlock Text="{Binding Entry.AttemptDisplay}"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Tooltip carries the full text: HistoryDisplay runs to ~90
                                 characters and would otherwise be cut mid-sentence. -->
                            <DataGridTemplateColumn Header="Last result" Width="3*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:QueueRow">
                                        <TextBlock Text="{Binding Entry.HistoryDisplay}"
                                                   ToolTip.Tip="{Binding Entry.HistoryDisplay}"
                                                   Foreground="#424A53"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- One status chip per row, coloured by group: green running,
                                 blue queued, amber needs review, red failed or stuck. -->
                            <DataGridTemplateColumn Header="Status" Width="136" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:QueueRow">
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" Margin="8,0"
                                                Background="{Binding Converter={StaticResource GroupColour}, ConverterParameter=chip}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                         Fill="{Binding Converter={StaticResource GroupColour}, ConverterParameter=dot}"/>
                                                <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" FontSize="11"
                                                           Foreground="{Binding Converter={StaticResource GroupColour}, ConverterParameter=ink}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1" x:Name="EmptyText" IsVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#57606A"
                               TextAlignment="Center" FontSize="13"
                               Text="Nothing waiting. New uploads appear here under Needs review."/>

                    <!-- The action bar offers only what makes sense for what is ticked. -->
                    <Border Grid.Row="2" Background="#FBF6EA" BorderBrush="#E6E9EE" BorderThickness="0,1,0,0">
                        <Grid Margin="16,10" ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectionText" Text="Tick videos to act on them"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button x:Name="SelectAllButton" Content="Select all" Click="SelectAll_Click"/>
                                <Button x:Name="ClearSelectionButton" Content="Clear" Click="ClearSelection_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="PreviewButton" Content="Preview" Click="Preview_Click"
                                        ToolTip.Tip="Open the highlighted video in your browser"/>
                                <Button x:Name="MoveUpButton" Content="Up" Click="MoveUp_Click"/>
                                <Button x:Name="MoveDownButton" Content="Down" Click="MoveDown_Click"/>
                                <Button x:Name="RejectButton" Content="Skip" Click="Reject_Click"
                                        BorderBrush="#B91C1C" Foreground="#B91C1C" FontWeight="SemiBold"
                                        ToolTip.Tip="Never analyze these"/>
                                <Button x:Name="StartBatchButton" Content="Queue for analysis" Click="StartBatch_Click"
                                        Background="#1D4ED8" BorderBrush="#1D4ED8" Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- Now running: this machine's job. -->
                <Border Classes="card" Margin="0,0,0,16">
                    <StackPanel Margin="16">
                        <TextBlock Text="Now running" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                        <StackPanel x:Name="ProcessingPanel" IsVisible="False">
                            <TextBlock x:Name="CurrentJobText" Text="None" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="JobProgressBar" Height="8" MinHeight="8" Margin="0,10,0,0"
                                         Background="#E6E9EE" Foreground="#15803D"
                                         Value="0" Minimum="0" Maximum="100"/>
                            <Grid Margin="0,6,0,12" ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="StageText" Text="Idle" Foreground="#57606A"/>
                                <TextBlock Grid.Column="1" x:Name="ProgressText" Text="0%" Foreground="#57606A"/>
                            </Grid>
                            <Button x:Name="CancelJobButton" Content="Cancel job" Click="CancelJobButton_Click"
                                    HorizontalAlignment="Left" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock x:Name="IdleText" Text="No job running." Foreground="#57606A" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Classes="card">
                    <Grid Margin="16" RowDefinitions="Auto,*">
                        <TextBlock Text="Activity" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                        <ListBox Grid.Row="1" x:Name="LogListBox" BorderThickness="0" Background="#F6F8FA"
                                 FontFamily="Menlo, Consolas, monospace" FontSize="11"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
