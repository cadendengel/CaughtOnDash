<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>CaughtOnDash.Worker</AssemblyName>
    <RootNamespace>CaughtOnDash.Worker</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Services, Models and Utils now live in the shared cross-platform core
         so the macOS host can reuse them. Namespaces are unchanged. -->
    <ProjectReference Include="..\CaughtOnDash.Worker.Core\CaughtOnDash.Worker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gitignored: it holds the API token. Copied only when present, so a
         fresh clone (and CI) still builds; the worker reports missing config
         at startup rather than the build failing. -->
    <Content Include="appsettings.json" Condition="Exists('appsettings.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
