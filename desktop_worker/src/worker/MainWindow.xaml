<Window x:Class="CaughtOnDash.Worker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CaughtOnDash Worker" Height="800" Width="1320" MinHeight="600" MinWidth="1100" 
        Background="#F5F5F5"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.Resources>
        <!-- Buttons shipped with the text against the edges; give them room. -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
            <StackPanel Margin="15">
                <TextBlock Text="CaughtOnDash Desktop Worker" FontSize="18" FontWeight="Bold" Foreground="#1a1a1a"/>
                <TextBlock Text="Process dashcam videos locally" Foreground="#666666" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="15">
            <!-- Log on the right because it is the tall content; status and
                 progress stack on the left. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Status & Controls -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Margin="0,0,0,15">
                    <StackPanel Margin="15">
                        <TextBlock Text="Worker Status" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Status:" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusText" Text="Stopped" Foreground="#E74C3C" FontSize="13" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Last Heartbeat:" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LastHeartbeatText" Text="Never" FontSize="13" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Current Job:" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CurrentJobText" Text="None" FontSize="13" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" 
                                    Background="#27AE60" Foreground="White" Margin="0,0,10,0" Height="35" Width="100"/>
                            <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" 
                                    Background="#E74C3C" Foreground="White" Height="35" Width="100" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" x:Name="ProcessingPanel" Visibility="Collapsed" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                    <StackPanel Margin="15">
                        <TextBlock Text="Processing" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Progress:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ProgressBar x:Name="ProgressBar" Height="20" Background="#E8E8E8" Foreground="#0066CC" Value="0" Minimum="0" Maximum="100"/>
                            <TextBlock x:Name="ProgressText" Text="0%" Margin="0,5,0,0" TextAlignment="Center" Foreground="#666666"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Stage:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="StageText" Text="Idle" FontSize="13" Foreground="#666666"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Job Details:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="JobDetailsText" Text="No active job" FontSize="13" Foreground="#666666" TextWrapping="Wrap" Height="80"/>
                        </StackPanel>

                        <Button x:Name="CancelJobButton" Content="Cancel Current Job" 
                                Background="#E67E22" Foreground="White" Height="35" IsEnabled="False"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" x:Name="IdlePanel" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                    <StackPanel Margin="15">
                        <TextBlock Text="Processing" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <TextBlock x:Name="IdleText" Text="No job running." FontSize="13" Foreground="#888888" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Margin="0,0,15,0" Background="White" BorderBrush="#E0E0E0"
                    BorderThickness="1" CornerRadius="5">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="QueueHeading" Text="Review Queue" FontWeight="Bold" FontSize="14"/>
                        <Button Grid.Column="1" x:Name="RefreshQueueButton" Content="Refresh"
                                Click="RefreshQueueButton_Click" Padding="10,3"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                        <Button x:Name="ReviewTabButton" Content="Awaiting review" Click="ReviewTab_Click" Margin="0,0,8,0"/>
                        <Button x:Name="QueuedTabButton" Content="Queued" Click="QueuedTab_Click" Margin="0,0,8,0"/>
                        <TextBlock x:Name="QueueCountText" VerticalAlignment="Center" Foreground="#666666"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="QueueGrid" AutoGenerateColumns="False"
                              GridLinesVisibility="Horizontal" CanUserReorderColumns="False"
                              CanUserSortColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Background="White" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Width="40"
                                                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Entry.Title}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Length" Binding="{Binding Entry.DurationDisplay}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Attempt" Binding="{Binding Entry.AttemptDisplay}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Last result" Binding="{Binding Entry.HistoryDisplay}" Width="2*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SelectAllButton" Content="Select all" Click="SelectAll_Click" Margin="0,0,8,0"/>
                        <Button x:Name="ClearSelectionButton" Content="Clear" Click="ClearSelection_Click" Margin="0,0,8,0"/>
                        <Button x:Name="PreviewButton" Content="Preview" Click="Preview_Click" Margin="0,0,8,0"
                                ToolTip="Open the selected video in your browser"/>
                        <Button x:Name="MoveUpButton" Content="Up" Click="MoveUp_Click" Margin="0,0,8,0"/>
                        <Button x:Name="MoveDownButton" Content="Down" Click="MoveDown_Click" Margin="0,0,8,0"/>
                        <Button x:Name="RejectButton" Content="Reject" Click="Reject_Click" Margin="0,0,8,0"
                                Background="#C0392B" Foreground="White"/>
                        <Button x:Name="StartBatchButton" Content="Start Batch" Click="StartBatch_Click"
                                Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="14,4"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: the activity log, full height -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Activity Log" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <ListBox Grid.Row="1" x:Name="LogListBox" BorderThickness="0" Background="#F9F9F9" Margin="2"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
            <StackPanel Orientation="Horizontal" Margin="15">
                <TextBlock Text="Version 0.1.0" Foreground="#999999" Margin="0,0,20,0"/>
            <TextBlock Text="Backend:" Foreground="#666666" Margin="0,0,5,0"/>
            <TextBlock x:Name="BackendUrlDisplay" Text="Not configured" Foreground="#0066CC"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
