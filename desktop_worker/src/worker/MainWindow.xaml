<Window x:Class="CaughtOnDash.Worker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CaughtOnDash Worker" Height="700" Width="900" 
        Background="#F5F5F5"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
            <StackPanel Margin="15">
                <TextBlock Text="CaughtOnDash Desktop Worker" FontSize="18" FontWeight="Bold" Foreground="#1a1a1a"/>
                <TextBlock Text="Process dashcam videos locally" Foreground="#666666" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Settings Panel -->
        <Border Grid.Row="1" Background="#FAFAFA" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
            <StackPanel Margin="15">
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Backend URL" Margin="0,0,0,5" FontWeight="SemiBold"/>
                        <TextBox x:Name="BackendUrlTextBox" Margin="2" Height="30" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Worker API Token" Margin="0,0,0,5" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="ApiTokenPasswordBox" Height="30" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Connect" Name="ConnectButton" Click="ConnectButton_Click" 
                            Background="#0066CC" Foreground="White" Margin="0,18,0,0" Height="30" VerticalAlignment="Top"/>
                </Grid>

                <TextBlock x:Name="ConnectionStatusText" Text="Not connected" Margin="0,5,0,0" Foreground="#E74C3C"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Status & Controls -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Margin="0,0,0,15">
                    <StackPanel Margin="15">
                        <TextBlock Text="Worker Status" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Status:" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusText" Text="Stopped" Foreground="#E74C3C" FontSize="13" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Last Heartbeat:" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LastHeartbeatText" Text="Never" FontSize="13" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Current Job:" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CurrentJobText" Text="None" FontSize="13" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" 
                                    Background="#27AE60" Foreground="White" Margin="0,0,10,0" Height="35" Width="100"/>
                            <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" 
                                    Background="#E74C3C" Foreground="White" Height="35" Width="100" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Logs Panel -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                    <StackPanel Margin="15">
                        <TextBlock Text="Activity Log" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <ListBox x:Name="LogListBox" Height="250" BorderThickness="0" Background="#F9F9F9" Margin="2">
                            <ListBoxItem Foreground="#666666">
                                <TextBlock Text="Ready to connect..." TextWrapping="Wrap"/>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right: Progress & Job Info -->
            <StackPanel Grid.Column="1">
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                    <StackPanel Margin="15">
                        <TextBlock Text="Processing" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Progress:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ProgressBar x:Name="ProgressBar" Height="20" Background="#E8E8E8" Foreground="#0066CC" Value="0" Minimum="0" Maximum="100"/>
                            <TextBlock x:Name="ProgressText" Text="0%" Margin="0,5,0,0" TextAlignment="Center" Foreground="#666666"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Stage:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="StageText" Text="Idle" FontSize="13" Foreground="#666666"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Job Details:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="JobDetailsText" Text="No active job" FontSize="13" Foreground="#666666" TextWrapping="Wrap" Height="80"/>
                        </StackPanel>

                        <Button x:Name="CancelJobButton" Content="Cancel Current Job" 
                                Background="#E67E22" Foreground="White" Height="35" IsEnabled="False"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
            <StackPanel Orientation="Horizontal" Margin="15">
                <TextBlock Text="Version 0.1.0" Foreground="#999999" Margin="0,0,20,0"/>
            <TextBlock Text="Backend:" Foreground="#666666" Margin="0,0,5,0"/>
            <TextBlock x:Name="BackendUrlDisplay" Text="Not configured" Foreground="#0066CC"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
